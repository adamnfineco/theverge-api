<img alt="" data-caption="" data-portal-copyright="" data-has-syndication-rights="1" src="https://platform.theverge.com/wp-content/uploads/sites/2/2026/06/Leica-Cine-Compact-1.jpg?quality=90&#038;strip=all&#038;crop=0,0,100,100" />
